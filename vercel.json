{
  "redirects": [
    { "source": "/blog/1", "destination": "/blog/glassmorphism-in-ui-design", "permanent": true },
    { "source": "/blog/2", "destination": "/blog/micro-interactions-with-framer-motion", "permanent": true },
    { "source": "/blog/3", "destination": "/blog/typography-in-minimalist-portfolios", "permanent": true },
    { "source": "/blog/4", "destination": "/blog/webgl-experiences-in-react", "permanent": true },
    { "source": "/blog/5", "destination": "/blog/color-psychology-in-luxury-branding", "permanent": true },
    { "source": "/case-study/1", "destination": "/case-study/lumina-real-estate", "permanent": true },
    { "source": "/case-study/2", "destination": "/case-study/volt-fitness", "permanent": true },
    { "source": "/case-study/3", "destination": "/case-study/osteria-roasters", "permanent": true },
    { "source": "/case-study/4", "destination": "/case-study/game-changers-gear", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/)(?!.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/:path*.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*.avif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
